source "https://rubygems.org"

# Plain Jekyll + plugins, built/deployed via the GitHub Actions workflow in
# .github/workflows/pages.yml — not the legacy "github-pages" gem, which pins
# ancient Jekyll/Liquid versions that no longer run on current Ruby.
gem "jekyll", "~> 4.3"
gem "jekyll-feed"
gem "jekyll-sitemap"
gem "jekyll-seo-tag"

gem "webrick"
